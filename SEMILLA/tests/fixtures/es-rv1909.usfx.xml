<w s="H6213">E hizo</w> <w s="H0430">Dios</w> <w s="H2416">animales</w> <w s="H0776">de la tierra</w> <w s="H4327">según su género</w>, <w s="H0929">y ganado</w> <w s="H4327">según su género</w>, <w s="H3605">y todo</w> <w s="H7431">animal</w> <w s="H0127">que anda arrastrando sobre la tierra</w> <w s="H4327">según su especie</w>: <w s="H7200">y vió</w> <w s="H0430">Dios</w> <w s="H3588">que</w> <w s="H2896">era bueno</w>.
<ve /><v id="26" />
<w s="H0559">Y dijo</w> <w s="H0430">Dios</w>: <w s="H6213">Hagamos</w> <w s="H0120">al hombre</w> <w s="H0587">á nuestra</w> <w s="H6754">imagen</w>, <w s="H0587">conforme á nuestra</w> <w s="H1823">semejanza</w>; <w s="H7287">y señoree</w> <w s="H1710">en los peces</w> <w s="H3220">de la mar</w>, <w s="H5775">y en las aves</w> <w s="H8064">de los cielos</w>, <w s="H0929">y en las bestias</w>, <w s="H3605">y en toda</w> <w s="H0776">la tierra</w>, <w s="H3605">y en todo</w> <w s="H7431">animal</w> <w s="H7430">que anda arrastrando</w> <w s="H5921">sobre</w> <w s="H0776">la tierra</w>.
<ve /><v id="27" />
<w s="H1254">Y crió</w> <w s="H0430">Dios</w> <w s="H0120">al hombre</w> <w s="H6754">á su imagen</w>, <w s="H6754">á imagen</w> <w s="H0430">de Dios</w> <w s="H1254">lo crió</w>; <w s="H2145">varón</w> <w s="H5347">y hembra</w> <w s="H1254">los crió</w>.
