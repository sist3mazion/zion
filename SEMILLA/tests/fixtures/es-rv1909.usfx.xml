<w s="H5414">Y púsolas</w> <w s="H0430">Dios</w> <w s="H7549">en la expansión</w> <w s="H8064">de los cielos</w>, <w s="H0215">para alumbrar</w> <w s="H5921">sobre</w> <w s="H0776">la tierra</w>,
