<ve /><v id="22" />
<w s="H0430">Y Dios</w> <w s="H1288">los bendijo</w> <w s="H0559">diciendo</w>: <w s="H6509">Fructificad</w> <w s="H7235">y multiplicad</w>, <w s="H4390">y henchid</w> <w s="H4325">las aguas</w> <w s="H3220">en los mares</w>, <w s="H5775">y las aves</w> <w s="H7235">se multipliquen</w> <w s="H0776">en la tierra</w>.
