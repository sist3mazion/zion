<w s="H7225">EN el principio</w> <w s="H1254">crió</w> <w s="H0430">Dios</w> <w s="H8064">los cielos</w> <w s="H0776">y la tierra</w>.
<ve /><v id="2" />
<w s="H0776">Y la tierra</w> <w s="H1961">estaba</w> <w s="H8414">desordenada</w> <w s="H0922">y vacía</w>, <w s="H2822">y las tinieblas</w> <w s="H5921">estaban sobre</w> <w s="H6440">la haz</w> <w s="H8415">del abismo</w>, <w s="H7307">y el Espíritu</w> <w s="H0430">de Dios</w> <w s="H7363">se movía</w> <w s="H5921">sobre</w> <w s="H6440">la haz</w> <w s="H4325">de las aguas</w>.
<ve /><v id="3" />
<w s="H0559">Y dijo</w> <w s="H0430">Dios</w>: <w s="H1961">Sea</w> <w s="H0216">la luz</w>: <w s="H1961">y fué</w> <w s="H0216">la luz</w>.
<ve /><v id="4" />
<w s="H7200">Y vió</w> <w s="H0430">Dios</w> <w s="H3588">que</w> <w s="H0216">la luz</w> <w s="H2896">era buena</w>: <w s="H0914">y apartó</w> <w s="H0430">Dios</w> <w s="H0216">la luz</w> <w s="H0996">de</w> <w s="H2822">las tinieblas</w>.
