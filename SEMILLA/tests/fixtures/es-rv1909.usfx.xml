<w s="H0559">Y dijo</w> <w s="H0430">Dios</w>: <w s="H3318">Produzca</w> <w s="H0776">la tierra</w> <w s="H5315">seres</w> <w s="H2416">vivientes</w> <w s="H4327">según su género</w>, <w s="H0929">bestias</w> <w s="H7431">y serpientes</w> <w s="H2416">y animales</w> <w s="H0776">de la tierra</w> <w s="H4327">según su especie</w>: <w s="H1961">y fué</w> <w s="H3651">así</w>.
