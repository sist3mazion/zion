<w s="H6213">E hizo</w> <w s="H0430">Dios</w> <w s="H8147">las dos</w> <w s="H1419">grandes</w> <w s="H3974">lumbreras</w>; <w s="H3974">la lumbrera</w> <w s="H1419">mayor</w> <w s="H4475">para que señorease</w> <w s="H3117">en el día</w>, <w s="H3974">y la lumbrera</w> <w s="H6996">menor</w> <w s="H4475">para que señorease</w> <w s="H3915">en la noche</w>: <add>hizo</add> <w s="H3556">también las estrellas</w>.
