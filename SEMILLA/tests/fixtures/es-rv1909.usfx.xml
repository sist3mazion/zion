<w s="H7121">Y llamó</w> <w s="H0430">Dios</w> <w s="H3004">á la seca</w> <w s="H0776">Tierra</w>, <w s="H4723">y á la reunión</w> <w s="H4325">de las aguas</w> <w s="H7121">llamó</w> <w s="H3220">Mares</w>: <w s="H7200">y vió</w> <w s="H0430">Dios</w> <w s="H3588">que</w> <w s="H2896">era bueno</w>.
<ve /><v id="11" />
<w s="H0559">Y dijo</w> <w s="H0430">Dios</w>: <w s="H1877">Produzca</w> <w s="H0776">la tierra</w> <w s="H1876">hierba</w> verde, <w s="H6212">hierba</w> <w s="H2233">que dé</w> <w s="H2233">simiente</w>; <w s="H6086">árbol</w> <w s="H6529">de fruto</w> <w s="H6213">que dé</w> <w s="H6529">fruto</w> <w s="H4327">según su género</w>, <w s="H0834">que</w> <w s="H2233">su simiente</w> esté en él, <w s="H5921">sobre</w> <w s="H0776">la tierra</w>: <w s="H1961">y fué</w> <w s="H3651">así</w>.
<ve /><v id="12" />
<w s="H3318">Y produjo</w> <w s="H0776">la tierra</w> <w s="H1877">hierba</w> verde, <w s="H6212">hierba</w> <w s="H2233">que da</w> <w s="H2233">simiente</w> <w s="H4327">según su naturaleza</w>, <w s="H6086">y árbol</w> <w s="H6213">que da</w> <w s="H6529">fruto</w>, <w s="H0834">cuya</w> <w s="H2232">simiente</w> está en él, <w s="H4327">según su género</w>: <w s="H7200">y vió</w> <w s="H0430">Dios</w> <w s="H3588">que</w> <w s="H2896">era bueno</w>.
