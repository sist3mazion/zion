<w s="H6213">E hizo</w> <w s="H0430">Dios</w> <w s="H7549">la expansión</w>, <w s="H0914">y apartó</w> <w s="H4325">las aguas</w> <w s="H0834">que</w> <w s="H8478">estaban debajo</w> <w s="H7549">de la expansión</w>, <w s="H4325">de las aguas</w> <w s="H0834">que</w> <w s="H5921">estaban sobre</w> <w s="H7549">la expansión</w>: <w s="H1961">y fué</w> <w s="H3651">así</w>.
<ve /><v id="8" />
